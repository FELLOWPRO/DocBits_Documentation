  "cards": [
    {
      "dot": "emerald",
      "title": "Processing",
      "items": [
        "Running covers OCR, classification, extraction and PO matching",
        "E-documents skip OCR; touchless documents skip straight to approval or export",
        "Restart clears the results and reruns the whole pipeline"
      ]
    },
    {
      "dot": "amber",
      "title": "Approval and export",
      "items": [
        "Approval steps are set per document type; second approval only when required",
        "Either approval step can reject or send back for correction",
        "DocFlow runs on every status change"
      ]
    }
  ]
