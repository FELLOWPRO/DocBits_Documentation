  "cards": [
    {
      "dot": "emerald",
      "title": "Processing",
      "items": [
        "Running covers OCR, classification, extraction and PO matching",
        "E-documents such as ZUGFeRD skip OCR",
        "Touchless documents skip validation and go to approval or export",
        "Restart clears the results and reruns the whole pipeline"
      ]
    },
    {
      "dot": "amber",
      "title": "Approval and export",
      "items": [
        "Approval and second approval are set per document type",
        "Either approval step can send the document to Pending export",
        "Both approval steps can also reject or send back for correction",
        "Export error can restart directly back to Pending export"
      ]
    }
  ]
}