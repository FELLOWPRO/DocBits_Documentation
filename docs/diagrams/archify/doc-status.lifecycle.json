{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "DocBits Document Status Lifecycle",
    "locale": "en",
    "quality_profile": "showcase",
    "viewBox": [
      980,
      660
    ]
  },
  "lanes": [
    {
      "id": "main",
      "label": "Main path"
    },
    {
      "id": "approval",
      "label": "Approval + export errors"
    },
    {
      "id": "terminal",
      "label": "Errors + final"
    }
  ],
  "states": [
    {
      "id": "new",
      "type": "start",
      "label": "New",
      "sublabel": "imported",
      "lane": "main",
      "col": 0,
      "step": "01"
    },
    {
      "id": "processing",
      "type": "active",
      "label": "Running",
      "sublabel": "OCR to PO match",
      "lane": "main",
      "col": 1,
      "step": "02"
    },
    {
      "id": "rfv",
      "type": "waiting",
      "label": "Ready for validation",
      "sublabel": "user checks",
      "lane": "main",
      "col": 2,
      "step": "03"
    },
    {
      "id": "pending-export",
      "type": "active",
      "label": "Pending export",
      "sublabel": "validated or approved",
      "lane": "main",
      "col": 3,
      "step": "04"
    },
    {
      "id": "exported",
      "type": "success",
      "label": "Exported",
      "sublabel": "sent to ERP",
      "lane": "main",
      "col": 4,
      "step": "05"
    },
    {
      "id": "approval1",
      "type": "waiting",
      "label": "Pending approval",
      "sublabel": "approver",
      "lane": "approval",
      "col": 0,
      "width": 118
    },
    {
      "id": "approval2",
      "type": "waiting",
      "label": "Second approval",
      "sublabel": "second approver",
      "lane": "approval",
      "col": 1,
      "width": 118
    },
    {
      "id": "export-error",
      "type": "failure",
      "label": "Export error",
      "sublabel": "ERP refused",
      "lane": "approval",
      "col": 2,
      "width": 118
    },
    {
      "id": "error",
      "type": "failure",
      "label": "Error",
      "sublabel": "recoverable fault",
      "lane": "terminal",
      "col": 0,
      "width": 118
    },
    {
      "id": "rejected",
      "type": "failure",
      "label": "Rejected",
      "sublabel": "final",
      "lane": "terminal",
      "col": 1,
      "width": 118
    }
  ],
