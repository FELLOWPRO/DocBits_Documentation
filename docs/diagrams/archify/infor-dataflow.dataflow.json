  "cards": [
    {
      "dot": "cyan",
      "title": "Inbound master data",
      "items": [
        "BODs: SupplierPartyMaster, RemitToPartyMaster, PurchaseOrder, ReceiveDelivery, plus SupplierInvoice, AdvanceShipNotice, SalesOrder, ItemMaster",
        "Main path: ION API call through the Infor API Gateway (OAuth) to DocBits /import/*_bod endpoints",
        "Optional alternative: ION Desk also feeds an AWS Kinesis BOD stream that DocBits polls every 60 seconds"
      ]
    },
    {
      "dot": "emerald",
      "title": "Export & Auto Accounting",
      "items": [
        "PDF + attributes always go to Infor IDM via ION API (/IDM/api/items)",
        "Either a direct ERP API call (M3 MI e.g. APS450MI, or LN SOAP ExternalInvoiceRegistration) or, when no direct exporter is configured, BOD Sync.CaptureDocument to ION Messaging (via ION API), which ION Desk then maps to target BODs for LN/M3 import",
        "GL account suggestions on the approval screen (optional); the exporter then sends the saved accounting lines",
        "Acknowledge BODs can optionally come back from Infor to confirm import"
      ]
    }
  ]
